#!/bin/sh
set -e
BOOT_CHECK=samsung-galaxybook-fprint-sdcp-boot-check.service
USER_CHECK=samsung-galaxybook-fprint-sdcp-user-check.timer
STATE=/var/lib/samsung-galaxybook
REMOVED="$STATE/galaxybook-fingerprint-manager.removed"

if [ "$1" = configure ]; then
    # Fingerprint login on, once per computer (whichever package comes first;
    # before the libfprint hash below, which marks computers set up by 2.1 and
    # earlier). FPRINT_PAM=0 leaves it off.
    bash /usr/lib/galaxybook-fingerprint-manager/tools/pam-first-install.sh || true
    # The hourly release check: enabled for every user once (first install, or
    # the upgrade that brings it); after that the admin's choice is kept.
    if [ ! -e /var/lib/samsung-galaxybook/galaxybook-fingerprint-manager-update-check.timer.set-up ]; then
        systemctl --global enable galaxybook-fingerprint-manager-update-check.timer >/dev/null 2>&1 || true
        mkdir -p /var/lib/samsung-galaxybook && touch /var/lib/samsung-galaxybook/galaxybook-fingerprint-manager-update-check.timer.set-up
    fi

    # First install (including the move from fingerprint-fix-sdcp 1.x, which
    # had these units), or installing again after a removal: enable the boot
    # check and every user's login check. Upgrades keep the admin's choice.
    if [ -z "$2" ] || [ -e "$REMOVED" ]; then
        rm -f "$REMOVED" "$STATE/fingerprint-fix-sdcp.removed"
        systemctl enable "$BOOT_CHECK" >/dev/null 2>&1 || true
        systemctl --global enable "$USER_CHECK" >/dev/null 2>&1 || true
        echo "Open 'Galaxy Book Fingerprint Manager' from the app menu to enrol a finger."
        # The same hint as a notification now, for anyone logged into a desktop
        # (shown once per user, so a move from 1.x shows nothing new).
        /usr/lib/galaxybook-fingerprint-manager/notify-users.sh || true
    fi

    # What the distro libfprint looked like, so the monitor tests it again
    # only once it changes.
    if [ ! -f "$STATE/libfprint-system.sha256" ]; then
        lib=$(ldconfig -p 2>/dev/null | grep 'libfprint-2\.so\.2 ' | awk '{print $NF}' | head -1)
        if [ -n "$lib" ]; then
            mkdir -p "$STATE"
            sha256sum "$lib" | awk '{print $1}' > "$STATE/libfprint-system.sha256"
        fi
    fi
fi

#DEBHELPER#
exit 0
