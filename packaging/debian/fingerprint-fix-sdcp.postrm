#!/bin/sh
set -e
case "$1" in
    remove|purge)
        # Back to the distro libfprint. The Manager, enrolled fingerprints
        # (/var/lib/fprint and on the sensor) and fingerprint login are kept.
        rm -f /run/systemd/system/fprintd.service.d/samsung-galaxybook-egismoc-sdcp.conf \
              /run/samsung-galaxybook/fprintd-sdcp.env
        systemctl daemon-reload >/dev/null 2>&1 || true
        systemctl try-restart fprintd.service >/dev/null 2>&1 || true
        ;;
esac
if [ "$1" = purge ] && [ ! -e /usr/lib/galaxybook-fingerprint-manager/installed ]; then
    # Purged with the Manager gone too: a later install counts as the first again.
    rm -f /var/lib/samsung-galaxybook/fingerprint-login-set-up
    rmdir /var/lib/samsung-galaxybook 2>/dev/null || true
fi

#DEBHELPER#
exit 0
