[Unit]
Description=Galaxy Book Fingerprint Manager — check GitHub for a new release (30 s after login, then hourly)
PartOf=graphical-session.target
After=graphical-session.target

[Timer]
OnActiveSec=30s
# Timers fire within a minute of their time by default: 30 s means 30 s.
AccuracySec=1s
OnCalendar=hourly
Unit=@MGR_UPDATE_SVC@

[Install]
WantedBy=graphical-session.target
