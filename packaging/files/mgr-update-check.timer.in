[Unit]
Description=Galaxy Book Fingerprint Manager — check GitHub for a new release (10 min after login, then hourly)
PartOf=graphical-session.target
After=graphical-session.target

[Timer]
OnActiveSec=10min
OnCalendar=hourly
RandomizedDelaySec=5min
Unit=@MGR_UPDATE_SVC@

[Install]
WantedBy=graphical-session.target
