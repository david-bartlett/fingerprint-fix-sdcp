[Unit]
Description=Galaxy Book Fingerprint Manager — check GitHub for a new release (1 min after login, then hourly)
PartOf=graphical-session.target
After=graphical-session.target

[Timer]
OnActiveSec=1min
OnCalendar=hourly
RandomizedDelaySec=1min
Unit=@MGR_UPDATE_SVC@

[Install]
WantedBy=graphical-session.target
