[Unit]
Description=fingerprint-fix-sdcp — check GitHub for a new release (10 s after login, then hourly)
PartOf=graphical-session.target
After=graphical-session.target

[Timer]
OnActiveSec=10s
# Timers fire within a minute of their time by default: 10 s means 10 s.
AccuracySec=1s
OnCalendar=hourly
Unit=@FIX_UPDATE_SVC@

[Install]
WantedBy=graphical-session.target
