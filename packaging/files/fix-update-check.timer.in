[Unit]
Description=fingerprint-fix-sdcp — check GitHub for a new release (1 min after login, then hourly)
PartOf=graphical-session.target
After=graphical-session.target

[Timer]
OnActiveSec=1min
OnCalendar=hourly
RandomizedDelaySec=1min
Unit=@FIX_UPDATE_SVC@

[Install]
WantedBy=graphical-session.target
