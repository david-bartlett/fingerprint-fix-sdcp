#!/bin/bash
# Samsung Galaxy Book — remove the egismoc SDCP driver installed by install.sh
# (runs as root). Leaves the Fingerprint Manager, its monitor and checks, and
# enrolled fingerprints: fprintd goes back to the distro's libfprint. Used by
# the Manager's "Remove", and with the Manager's own cleanup by the packages
# when they replace an install.sh copy.
rm -f "@FPRINT_DROPIN@" "@FPRINT_DROPIN@.testing" "@FPRINT_ENV_SCRIPT@" "@FPRINT_ENV_FILE@" "@FPRINT_OTHER_FIX@"
rmdir "@FPRINT_DROPIN_DIR@" 2>/dev/null || true
rm -rf "@FPRINT_LIB_DIR@"
# The driver's hourly release check (a user timer in each user's home).
for _home in /home/*/; do
    rm -f "${_home}.config/systemd/user/@FIX_UPDATE_SVC@" \
          "${_home}.config/systemd/user/fingerprint-fix-sdcp-update-check.timer" \
          "${_home}.config/systemd/user/graphical-session.target.wants/fingerprint-fix-sdcp-update-check.timer"
done
rm -f "@FPRINT_MARKER@" "@FPRINT_CLEANUP@"
systemctl daemon-reload 2>/dev/null || true
systemctl try-restart fprintd 2>/dev/null || true
