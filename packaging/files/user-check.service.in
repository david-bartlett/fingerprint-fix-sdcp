[Unit]
Description=Samsung Galaxy Book — egismoc SDCP fingerprint fix login check
# Started by samsung-galaxybook-fprint-sdcp-user-check.timer; no [Install] section on purpose.
# Not for system accounts: the login screen's own session (gdm, sddm) is a
# user session too, and with the packages' "systemctl --global enable" this
# would run there, before anyone has logged in.
ConditionUser=!@system

[Service]
Type=oneshot
ExecStart=@FPRINT_USER_CHECK_SCRIPT@
