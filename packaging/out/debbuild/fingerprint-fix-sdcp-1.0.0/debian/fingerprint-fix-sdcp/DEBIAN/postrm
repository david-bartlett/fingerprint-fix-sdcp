#!/bin/sh
set -e
case "$1" in
    remove|purge)
        # Back to the distro libfprint. Enrolled fingerprints (/var/lib/fprint
        # and on the sensor) and the fingerprint-login setting are kept.
        rm -f /run/systemd/system/fprintd.service.d/samsung-galaxybook-egismoc-sdcp.conf
        systemctl daemon-reload >/dev/null 2>&1 || true
        systemctl try-restart fprintd.service >/dev/null 2>&1 || true
        ;;
esac
if [ "$1" = purge ]; then
    # This fix's own state; never fprintd's records.
    rm -f /var/lib/samsung-galaxybook/libfprint-system.sha256
    rm -rf /var/lib/samsung-galaxybook/removed-fingerprints \
           /var/lib/samsung-galaxybook/replaced-fingerprints
    rmdir /var/lib/samsung-galaxybook 2>/dev/null || true
fi


exit 0
