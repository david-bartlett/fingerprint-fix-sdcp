#!/bin/bash
# Samsung Galaxy Book — egismoc SDCP fingerprint fix user check (runs as user)
# 1. Starts the root monitor (allowed by polkit) and shows any notification it left.
# 2. Shows the result of the boot-time sensor check, once per boot.
# Status files: line 1 = icon, line 2 = title, line 3 = message.
FPRINT_STATUS_FILE="/run/samsung-galaxybook/fprint-sdcp-status"
FPRINT_BOOT_STATUS="/run/samsung-galaxybook/fprint-sdcp-boot-status"
[[ -f "@FPRINT_MARKER@" ]] || exit 0

show() {
    local ICON TITLE MSG
    { IFS= read -r ICON; IFS= read -r TITLE; IFS= read -r MSG; } < "$1"
    [[ -n "$TITLE" ]] || return 0
    notify-send -t 0 -a "Samsung Galaxy Book Fixes" -i "${ICON:-dialog-information}" "$TITLE" "$MSG" \
        || logger -t samsung-galaxybook-fprint-sdcp-user-check "notify-send failed: $TITLE: $MSG"
}

if systemctl start samsung-galaxybook-fprint-sdcp-monitor.service; then
    [[ -s "$FPRINT_STATUS_FILE" ]] && show "$FPRINT_STATUS_FILE"
fi

# The boot check result lives until the next reboot; show it once per boot,
# not at every login.
if [[ -s "$FPRINT_BOOT_STATUS" ]]; then
    SHOWN="${XDG_CACHE_HOME:-$HOME/.cache}/samsung-galaxybook/fprint-sdcp-boot-shown"
    BOOT_ID=$(cat /proc/sys/kernel/random/boot_id 2>/dev/null)
    if [[ "$(cat "$SHOWN" 2>/dev/null)" != "$BOOT_ID" ]]; then
        show "$FPRINT_BOOT_STATUS"
        mkdir -p "$(dirname "$SHOWN")" && echo "$BOOT_ID" > "$SHOWN"
    fi
fi

# Hints that point to the Fingerprint Manager, each shown once per user:
#  - no finger enrolled yet: enrol one and turn on fingerprint login
#  - fingers enrolled, but fingerprint login (PAM) is off: turn it on
# With an "Open Fingerprint Manager" button where the desktop supports it.
# Retried next login if fprintd can't answer yet.
HINTS="${XDG_CACHE_HOME:-$HOME/.cache}/samsung-galaxybook"
hint() {
    local shown="$HINTS/$1"; shift
    [[ -f "$shown" ]] && return 0
    systemd-run --user --quiet --collect "@MGR_DIR@/lib/notify-open-manager.sh" "$@" 2>/dev/null \
        || notify-send -t 0 -a "Samsung Galaxy Book Fixes" -i galaxybook-fingerprint-manager "$@" \
        || { logger -t samsung-galaxybook-fprint-sdcp-user-check "notify-send failed: $1"; return 0; }
    mkdir -p "$HINTS" && touch "$shown"
}
if LIST=$(timeout 15 fprintd-list "$USER" 2>/dev/null); then
    if ! grep -qE '^ *- #[0-9]+:' <<< "$LIST"; then
        hint fprint-sdcp-welcome-shown "Samsung Galaxy Book — Fingerprint Sensor Ready" \
            "Open Galaxy Book Fingerprint Manager to enrol a finger and turn on fingerprint login."
    else
        PAM=$(bash "@MGR_DIR@/tools/fingerprint-pam.sh" status --short 2>/dev/null)
        if [[ "${PAM%%|*}" == disabled || "${PAM%%|*}" == partial ]]; then
            hint fprint-sdcp-pam-hint-shown "Samsung Galaxy Book — Fingerprint Login Is Off" \
                "Your fingerprint is set up, but login and sudo still ask for your password. Turn on \"Use fingerprint for login and sudo\" in Galaxy Book Fingerprint Manager."
        fi
    fi
fi

# A newer fingerprint-fix-sdcp release on GitHub: one notification per release
# (at most one request a day, shared with the Manager; off with the Manager's
# "Check for new versions").
if [[ -f "@MGR_DIR@/lib/update_check.py" ]]; then
    timeout 20 python3 "@MGR_DIR@/lib/update_check.py" --notify 2>/dev/null || true
fi
