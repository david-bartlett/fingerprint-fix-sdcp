# fingerprint-fix-sdcp (the driver) — pacman install scripts (run as root,
# never interactive)
#
# Only fprintd needs to change at once, so fingerprints work without a reboot.
# The boot and login checks, fingerprint login (PAM), enrolling and importing
# belong to galaxybook-fingerprint-manager, which this package requires.

# fprintd picks up the drop-in that points it at the driver. The drop-in
# changes fprintd's environment, so a daemon-reload must come first (pacman's
# own reload hook runs after these scripts).
_reload_fprintd() {
    systemctl daemon-reload 2>/dev/null || true
    systemctl try-restart fprintd.service 2>/dev/null || true
}

# Another fingerprint fix's fprintd setup (e.g. a manual install of Abdallah's
# libfprint-egismoc-sdcp): moved aside, with a backup and how to restore it.
_takeover() {
    bash /usr/lib/fingerprint-fix-sdcp/other-fix.sh takeover || true
}

# Only for a Galaxy Book4 / Book5 with the Egis reader (USB 1c7a:05a5 / 05a1):
# elsewhere fprintd needs the distro's drivers, which the fix's library lacks.
# Same rule as packaging/files/fprintd-env.sh.in, install.sh and the Manager —
# this script runs before the package's files exist, so it has its own copy.
# Prints why not, and fails, on other hardware. pacman can't be stopped from
# here, so pre_install only warns; fprintd-env.sh keeps other hardware on the
# distro libfprint.
fix_hardware_problem() {
    _vendor=$(cat /sys/class/dmi/id/sys_vendor /sys/class/dmi/id/board_vendor 2>/dev/null | tr '[:upper:]' '[:lower:]')
    case "$_vendor" in
        *samsung*) ;;
        *) echo "this computer is not a Samsung (vendor: $(head -n1 /sys/class/dmi/id/sys_vendor 2>/dev/null || echo unknown))"
           return 1 ;;
    esac
    # Galaxy Book3 laptops can have the same 1c7a:05a1 reader as the Book4, but
    # this fix is only tested on the Book4 and Book5: refused there. Recognised
    # by the family name, or the model code: NP / 3 digits / X (laptop) or Q
    # (360) / generation letter, F = Book3 (G = Book4, H = Book5).
    _family=$(cat /sys/class/dmi/id/product_family 2>/dev/null)
    _model=$(cat /sys/class/dmi/id/product_name 2>/dev/null)
    if echo "$_family" | grep -Eqi 'galaxy ?book ?3($|[^0-9])' \
            || echo "$_model" | grep -Eqi '^(NP)?[0-9]{3}[XQ]F'; then
        echo "this is a Galaxy Book3 (${_family:-model $_model}), which this fix isn't tested on"
        return 1
    fi
    for _d in /sys/bus/usb/devices/*; do
        [ "$(cat "$_d/idVendor" 2>/dev/null)" = 1c7a ] || continue
        case "$(cat "$_d/idProduct" 2>/dev/null)" in 05a5|05a1) return 0 ;; esac
    done
    echo "that reader was not found on this computer"
    return 1
}

pre_install() {
    local why
    [[ "${FPRINT_SDCP_FORCE:-0}" == 1 ]] && return 0
    why=$(fix_hardware_problem) && return 0
    echo "==> WARNING: fingerprint-fix-sdcp is only for the Samsung Galaxy Book4 and Book5"
    echo "    with the Egis fingerprint reader (USB 1c7a:05a5 or 1c7a:05a1), but $why."
    echo "    fprintd keeps using the distro's libfprint here, so any other fingerprint"
    echo "    reader still works. Remove the packages:"
    echo "      sudo pacman -R fingerprint-fix-sdcp galaxybook-fingerprint-manager"
}

post_install() {
    _takeover
    _reload_fprintd
    if [[ -f /etc/samsung-galaxybook-egismoc-sdcp.installed || -f /etc/galaxybook-fingerprint-manager.installed ]]; then
        echo "==> WARNING: a copy of fingerprint-fix-sdcp installed with install.sh is still here,"
        echo "    and its fprintd drop-in in /etc takes priority over this package."
        echo "    Remove it, keeping your fingerprints, from the fingerprint-fix-sdcp folder:"
        echo "      sudo bash uninstall.sh"
    fi
}

post_upgrade() {
    _takeover
    _reload_fprintd
}

post_remove() {
    rm -f /run/systemd/system/fprintd.service.d/samsung-galaxybook-egismoc-sdcp.conf \
          /run/samsung-galaxybook/fprintd-sdcp.env
    _reload_fprintd
    echo "==> fprintd uses the distro libfprint again. The Fingerprint Manager and enrolled"
    echo "    fingerprints are kept (/var/lib/fprint and on the sensor); reinstalling the"
    echo "    driver uses them again."
}
