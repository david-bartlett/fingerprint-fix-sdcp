# Maintainer: David Bartlett <22402006+david-bartlett@users.noreply.github.com>
#
# fingerprint-fix-sdcp @VERSION@ for Arch and Arch-based distros (CachyOS, EndeavourOS, …)
# Attached to the GitHub release; builds that release, with its tested driver,
# against this system's current libraries.
#
#   sudo pacman -S --needed base-devel git
#   Put this file and fingerprint-fix-sdcp.install in one folder, then:
#   makepkg -si
#
# Written by .github/workflows/release-packages.yml from
# packaging/arch/PKGBUILD.release.in — change that file, not a copy.

pkgname=fingerprint-fix-sdcp
pkgver=@VERSION@
pkgrel=1
_driver=@DRIVER@
pkgdesc="Egis match-on-chip fingerprint reader fix for Samsung Galaxy Book (egismoc SDCP driver for fprintd), with the Galaxy Book Fingerprint Manager"
arch=('x86_64')
url="https://github.com/david-bartlett/fingerprint-fix-sdcp"
license=('GPL-2.0-or-later' 'LGPL-2.1-or-later')   # the fix; the driver (libfprint)
depends=(
    'fprintd' 'libfprint' 'glib2' 'libgusb' 'openssl'
    'bash' 'systemd' 'usbutils' 'libnotify' 'polkit'
    'python' 'python-gobject' 'python-cairo' 'gtk3'
)
makedepends=('git' 'meson' 'ninja' 'pkgconf' 'glib2-devel' 'patch')
install=fingerprint-fix-sdcp.install
options=('!debug')            # no separate -debug package in the release downloads
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz"
        "libfprint-egismoc-sdcp::git+https://github.com/david-bartlett/libfprint-egismoc-sdcp.git#commit=$_driver")
sha256sums=('@SHA256@'
            'SKIP')            # a git source is pinned by its commit id

# Only for a Samsung with the Galaxy Book's Egis reader (USB 1c7a:05a5 / 05a1):
# elsewhere fprintd needs the distro's drivers, which this driver build lacks.
# Same rule as packaging/files/fprintd-env.sh.in, the deb / rpm pre-install
# scripts, install.sh and the Manager. Stops before anything is built;
# FPRINT_SDCP_FORCE=1 makepkg -si builds anyway (e.g. for a system image).
# (Not in packaging/arch/PKGBUILD: CI builds that one without the reader.)
prepare() {
    [[ "${FPRINT_SDCP_FORCE:-0}" == 1 ]] && return 0
    local vendor d why=""
    vendor=$(cat /sys/class/dmi/id/sys_vendor /sys/class/dmi/id/board_vendor 2>/dev/null)
    local family model
    family=$(cat /sys/class/dmi/id/product_family 2>/dev/null)
    model=$(cat /sys/class/dmi/id/product_name 2>/dev/null)
    if [[ "${vendor,,}" != *samsung* ]]; then
        why="this computer is not a Samsung (vendor: $(head -n1 /sys/class/dmi/id/sys_vendor 2>/dev/null || echo unknown))"
    # Galaxy Book3: can have the same 05a1 reader, but untested — refused. Model
    # code generation letter after X/Q: F = Book3, G = Book4, H = Book5.
    elif grep -Eqi 'galaxy ?book ?3($|[^0-9])' <<< "$family" || grep -Eqi '^(NP)?[0-9]{3}[XQ]F' <<< "$model"; then
        why="this is a Galaxy Book3 (${family:-model $model}), which this fix isn't tested on"
    else
        why="that reader was not found on this computer"
        for d in /sys/bus/usb/devices/*; do
            [[ "$(cat "$d/idVendor" 2>/dev/null)" == 1c7a ]] || continue
            [[ "$(cat "$d/idProduct" 2>/dev/null)" =~ ^05a[15]$ ]] && return 0
        done
    fi
    echo >&2
    echo "fingerprint-fix-sdcp is only for the Samsung Galaxy Book4 and Book5 with the" >&2
    echo "Egis fingerprint reader (USB 1c7a:05a5 or 1c7a:05a1), but $why." >&2
    echo "Nothing was built: any other fingerprint reader works with your distro's own" >&2
    echo "driver. To build anyway (e.g. for a system image for a Galaxy Book):" >&2
    echo "  FPRINT_SDCP_FORCE=1 makepkg -si" >&2
    echo >&2
    return 1
}

build() {
    bash "$srcdir/$pkgname-$pkgver/packaging/build-driver.sh" "$srcdir/libfprint-egismoc-sdcp"
}

package() {
    local repo="$srcdir/$pkgname-$pkgver"
    bash "$repo/packaging/install-files.sh" "$pkgdir" "$srcdir/libfprint-egismoc-sdcp" \
        "$pkgver-$pkgrel" pacman
    install -Dm644 -t "$pkgdir/usr/share/doc/$pkgname" "$repo/README.md" "$repo/CHANGELOG.md"
}
